# ==============================
# MediVantage Solutions
# Git Ignore
# ==============================

# ------------------------------
# Python / FastAPI
# ------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ------------------------------
# Environment / Secrets
# ------------------------------
.env
.env.*
!.env.example

# Render / deployment secrets
render.yaml.local
*.secret
*.secrets

# ------------------------------
# PostgreSQL / Local Database
# ------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------
# Node / React / Vite
# ------------------------------
node_modules/
dist/
build/
.vite/
.cache/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------
# IDE / Editor
# ------------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------------
# OS files
# ------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------
# Logs / Temp
# ------------------------------
*.log
logs/
tmp/
temp/

# ------------------------------
# Local generated / test files
# ------------------------------
backend/ai_insight_*.json
backend/fraud_*.json

# ------------------------------
# Backups
# ------------------------------
*.backup
*.bak
*.old

# ------------------------------
# Misc
# ------------------------------
*.pid
*.pid.lock

# ------------------------------
# Legacy root-level development remnants
# Keep locally, exclude from deployment repository
# ------------------------------
/frontend-broken/
/app/
/src/
/package.json
/package-lock.json